{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Knowledge Card Frontmatter",
  "description": "Schema for the YAML frontmatter only; Markdown body headings are validated separately.",
  "type": "object",
  "required": [
    "title",
    "source_url",
    "source_type",
    "source_products",
    "source_date",
    "verified_on",
    "language",
    "tags",
    "status",
    "license_note"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_type": {
      "enum": [
        "course",
        "tutorial",
        "documentation",
        "article",
        "video",
        "workshop",
        "transcript",
        "other"
      ]
    },
    "source_products": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "verified_on": {
      "type": "string",
      "format": "date"
    },
    "language": {
      "type": "string",
      "minLength": 2
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "current",
        "needs-verification",
        "archived"
      ]
    },
    "time_sensitive": {
      "type": "boolean"
    },
    "license_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
