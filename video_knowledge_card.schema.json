{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Claude Video Knowledge Card",
  "type": "object",
  "required": [
    "title",
    "source_url",
    "summary",
    "procedure",
    "verification",
    "status"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "source_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "knowledge_checked": {
      "type": "string",
      "format": "date"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "level": {
      "enum": [
        "base",
        "intermedio",
        "avanzato",
        "misto"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "when_to_use": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "prerequisites": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "procedure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reusable_prompts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pitfalls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "time_sensitive_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "current",
        "needs-verification",
        "archived"
      ]
    },
    "candidate_for": {
      "type": "array",
      "items": {
        "enum": [
          "project-instructions",
          "claude-md",
          "skill",
          "connector-mcp",
          "subagent",
          "hook",
          "reference-only"
        ]
      }
    }
  }
}